# Copy to .env for local overrides. Every variable is optional; the values below are the defaults.
# Never put real secrets in this file: it is committed.

# Runtime environment: dev | test | prod
DOORWAY_ENV=dev

# Postgres (async driver required)
DOORWAY_DATABASE_URL=postgresql+asyncpg://doorway:doorway@localhost:5432/doorway

# Redis (redis:// or rediss:// for TLS)
DOORWAY_REDIS_URL=redis://localhost:6379/0

# DEBUG | INFO | WARNING | ERROR
DOORWAY_LOG_LEVEL=INFO

# Seconds each readiness probe may take before it counts as failed (0 < value <= 30)
DOORWAY_PROBE_TIMEOUT_SECONDS=2.0

# --- Providers (phase 2). None is needed: the mock provider answers model "mock" with no key. ---

# Anthropic: enables models named claude-*. ANTHROPIC_API_KEY works too.
# DOORWAY_ANTHROPIC_API_KEY=
# DOORWAY_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible server: enables every other model name. OPENAI_API_KEY works too.
# A key alone uses https://api.openai.com/v1; a base URL alone suits local servers (no key).
# DOORWAY_OPENAI_API_KEY=
# DOORWAY_OPENAI_BASE_URL=http://localhost:11434/v1

# The deterministic mock provider (models "mock" and "mock-*")
DOORWAY_MOCK_PROVIDER_ENABLED=true

# Seconds an upstream call may take (0 < value <= 600)
DOORWAY_UPSTREAM_TIMEOUT_SECONDS=60

# --- Reliability (phase 3) ---

# Model aliases with ordered fallback chains (JSON). Clients ask for "smart"; the gateway tries
# each model in turn. With no keys set, try: {"smart": ["mock-error-503", "mock"]}
# DOORWAY_MODEL_ROUTES={"smart": ["claude-sonnet-5-5", "gpt-5", "mock"]}

# Retries per target (first try included) with full-jitter exponential backoff
DOORWAY_RETRY_MAX_ATTEMPTS=3
DOORWAY_RETRY_BASE_SECONDS=0.2
DOORWAY_RETRY_CAP_SECONDS=2.0

# Circuit breaker per target (provider/model), state in Redis, shared by replicas
DOORWAY_BREAKER_FAILURE_THRESHOLD=5
DOORWAY_BREAKER_WINDOW_SECONDS=60
DOORWAY_BREAKER_COOLDOWN_SECONDS=30
DOORWAY_BREAKER_TRIAL_TIMEOUT_SECONDS=10

# Token-bucket rate limits, requests per minute (0 turns a limit off)
DOORWAY_RATE_LIMIT_KEY_PER_MINUTE=600
DOORWAY_RATE_LIMIT_TENANT_PER_MINUTE=3000
